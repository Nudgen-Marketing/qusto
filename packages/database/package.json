{
  "name": "@qusto/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./public-runtime": {
      "types": "./src/public-runtime.ts",
      "import": "./dist/public-runtime.js"
    },
    "./registration": {
