    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@qusto/control-plane": "workspace:*",
    "@qusto/policy-engine": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
