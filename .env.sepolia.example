# Load after .env when running the opt-in Base Sepolia profile.
BASE_NETWORK=base-sepolia
BASE_RPC_URL=https://sepolia.base.org

# Use a dedicated testnet recipient. The seller never receives its private key.
SEPOLIA_E2E_PAY_TO=0xreplace-with-a-testnet-recipient-address
SEPOLIA_E2E_FACILITATOR_URL=https://x402.org/facilitator
SEPOLIA_E2E_KEEP_DATA=false

# Put a dedicated funded buyer key in this ignored, mode-0600 file.
SEPOLIA_E2E_PRIVATE_KEY_FILE=./.secrets/base-sepolia-private-key
