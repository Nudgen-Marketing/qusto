# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-long-random-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes

# Generate a 32-byte base64url key, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QUSTO_ENCRYPTION_KEY=replace-with-a-32-byte-base64url-key

BASE_RPC_URL=https://your-base-rpc.example
QUSTO_PUBLIC_URL=http://localhost:3000
QUSTO_PORT=3000

# Optional retention and worker settings
QUSTO_TRACE_RETENTION_DAYS=90
QUSTO_AUDIT_RETENTION_DAYS=365
