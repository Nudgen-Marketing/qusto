{
  "name": "qusto",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.1",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.10"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test:e2e": "playwright test",
    "test:e2e:sepolia": "vitest run --config apps/test-seller/vitest.live.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "turbo": "^2.6.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.1.10"
  }
}
